# Credenciais da API do Telegram (https://my.telegram.org/apps > API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Sessão da sua conta. Gere com `npm run telegram:login` e cole aqui.
# Dá acesso total à sua conta do Telegram: trate como senha.
TELEGRAM_SESSION=

# Opcional. Se definido (ex.: HABIT_PREFIX="#h"), só mensagens do Saved Messages que começam
# com esse prefixo são tratadas como hábitos. Vazio = toda mensagem de texto é hábito.
# Use aspas: em arquivos .env, um # sem aspas inicia um comentário.
HABIT_PREFIX=

# Token exigido no header "Authorization: Bearer <token>" do POST /api/telegram/sync.
# Obrigatório em produção; opcional em dev.
SYNC_SECRET=
